# AuditLens — production deployment environment.
#
# Copy to `.env` in this directory and fill in. Never commit the filled copy
# (05_SECURITY.md §10.6). The production overlay declares every variable below
# as `${VAR:?...}`, so a missing one aborts `docker compose up` with a message
# naming it rather than starting a container that is quietly misconfigured.
#
# Every variable here also appears in 09_DEPLOYMENT.md's table.

# --- Database ----------------------------------------------------------------
# The application's database user must NOT be a Postgres superuser
# (09_DEPLOYMENT.md § Deployment Security).
POSTGRES_USER=auditlens_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=auditlens

# Must match the three values above. The host is the compose service name.
DATABASE_URL=postgresql+psycopg://auditlens_app:CHANGE_ME@db:5432/auditlens

# --- Application secrets -----------------------------------------------------
# 32+ bytes of randomness. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME

# Anthropic API key (ADR-009). Rotatable without a code change — it is read
# from the environment at process start (05_SECURITY.md §10.6).
LLM_API_KEY=CHANGE_ME

# --- Transport ---------------------------------------------------------------
# The public origin the frontend is served from. Must be https in production;
# startup validation rejects an http value.
CORS_ALLOWED_ORIGIN=https://auditlens.CHANGE_ME.tld

# Cloudflare Tunnel token, from the Zero Trust dashboard. This is the only
# ingress — no host port is published for the API, the web app, or the database.
TUNNEL_TOKEN=CHANGE_ME

# --- Backups -----------------------------------------------------------------
# How long to keep local pg_dump files. Copying them off this host is a separate
# step the operator configures; a backup on the same disk as its database
# protects against operator error, not against losing the disk.
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_SECONDS=86400

# Stamped onto every ControlEvaluation and every Report, so a result can always
# be traced to the exact logic and control corpus that produced it — and a later
# change to either can never rewrite what a finalized report already claims
# (09_DEPLOYMENT.md, 03_DATA_MODEL.md).
RULE_ENGINE_VERSION=1.0.0
CONTROL_CORPUS_VERSION=pci-dss-v4.0.1-poc-2

# --- OCR ---------------------------------------------------------------------
# Which engine reads text out of image evidence (screenshots, scans, photos).
#
#   tesseract     Local binary. No key, no network, nothing leaves the server.
#                 Weak on skewed scans, phone photos and low-contrast consoles.
#   google_vision Google Cloud Vision. Best accuracy on real-world evidence.
#                 Needs an API key with the Vision API enabled.
#   ocr_space     OCR.space. Simplest to start with and has a free tier.
#
# Sending client evidence to a third party is a disclosure decision. The default
# is deliberately local so that choice is made, never inherited.
OCR_PROVIDER=tesseract

# Required when OCR_PROVIDER is google_vision or ocr_space. Never logged.
OCR_API_KEY=

# Optional. Leave blank to use the provider's documented endpoint; set it to
# point at a proxy or a self-hosted compatible service.
OCR_API_URL=

OCR_TIMEOUT_SECONDS=30

# When the API fails, retry with the local binary rather than failing the
# document. A degraded read plus a logged warning beats an upload that silently
# produces nothing. Set false if evidence must never be read by a weaker engine
# without someone noticing.
OCR_FALLBACK_TO_LOCAL=true
