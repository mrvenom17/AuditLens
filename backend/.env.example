# AuditLens — example environment file.
# Copy to `.env` and fill in real values. `.env` is gitignored and must never be
# committed (05_SECURITY.md §10.6). Every variable here mirrors the table in
# 09_DEPLOYMENT.md — adding one means updating that table too.

# local | test | production
ENVIRONMENT=local

# Postgres connection string. The application's database user must not be a
# superuser (09_DEPLOYMENT.md § Deployment Security).
# For local development against the compose stack, the host port is 5433
# (see deploy/docker-compose.yml). In production this is the in-network host.
DATABASE_URL=postgresql+psycopg://auditlens:CHANGE_ME@localhost:5433/auditlens

# Session-signing / token secret. 32+ bytes of randomness.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME_32_BYTES_MINIMUM_RANDOM_STRING

# Anthropic API key (ADR-009). Never logged, never returned in a response.
LLM_API_KEY=CHANGE_ME
LLM_MODEL=claude-sonnet-5

# Stamped onto every ControlEvaluation and every Report, so a result can always
# be traced to the exact logic and control corpus that produced it — and a later
# change to either can never rewrite what a finalized report already claims
# (09_DEPLOYMENT.md, 03_DATA_MODEL.md).
RULE_ENGINE_VERSION=1.0.0
CONTROL_CORPUS_VERSION=pci-dss-v4.0.1-poc-2

# Self-hosted embedding model (ADR-005). Loaded only by the worker process.
EMBEDDING_MODEL_PATH=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Evidence file storage root. Must be a persistent volume — these are the
# evidentiary records and are never deleted (01_REQUIREMENTS.md).
FILE_STORAGE_PATH=./data/evidence
MAX_UPLOAD_SIZE_MB=25

# Frontend origin permitted by CORS. No wildcard (05_SECURITY.md §10.9).
# Must be https in production.
CORS_ALLOWED_ORIGIN=http://localhost:3000
